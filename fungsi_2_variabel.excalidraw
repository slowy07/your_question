      "updated": 1749477434452,
      "link": null,
      "locked": false,
      "text": "f(2,3) =5(2)^2\n +3(2)(3)+4(3)^2\n +10(2)+20(3)+100\n=5(4)+3(6)+4(9)+20+60+100\n=20+18+36+20+60+100\n=(20+18)+(36+20)+(60+100)\n=38+56+160\n=254 per unit\n\n2 unit = 508jt\n​\n- adi :)\n \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(2,3) =5(2)^2\n +3(2)(3)+4(3)^2\n +10(2)+20(3)+100\n=5(4)+3(6)+4(9)+20+60+100\n=20+18+36+20+60+100\n=(20+18)+(36+20)+(60+100)\n=38+56+160\n=254 per unit\n\n2 unit = 508jt\n​\n- adi :)\n \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
