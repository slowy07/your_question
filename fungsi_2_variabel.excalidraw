    {
      "id": "ve5UTQ8whHIrz6OYPmH6K",
      "type": "text",
      "x": 147858.57454546922,
      "y": 31546.63148708208,
      "width": 1042.5604248046875,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
