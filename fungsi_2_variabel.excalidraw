      "versionNonce": 1924609898,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1749479538256,
      "link": null,
      "locked": false,
      "text": "C(2, 3) = 5(2)^2 + 3(2)(3) + 4(3)^2 + 10(2) + 20(3) + 100\n = 5(4) + 3(6) + 4(9) + 20 + 60 + 100\n = 20 + 18 + 36 + 20 + 60 + 100\n= 254 \n\n2x254 = 508 juta",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C(2, 3) = 5(2)^2 + 3(2)(3) + 4(3)^2 + 10(2) + 20(3) + 100\n = 5(4) + 3(6) + 4(9) + 20 + 60 + 100\n = 20 + 18 + 36 + 20 + 60 + 100\n= 254 \n\n2x254 = 508 juta",
      "autoResize": true,
      "lineHeight": 1.25
    },
