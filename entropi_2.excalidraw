      "text": "2^3.3\n\n2^3 = 8\n2^4 = 16\n\n16 - 8 = 8",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2^3.3\n\n2^3 = 8\n2^4 = 16\n\n16 - 8 = 8",
      "autoResize": true,
      "lineHeight": 1.25
    },
