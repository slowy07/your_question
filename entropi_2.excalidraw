      "updated": 1748873684995,
      "link": null,
      "locked": false,
      "text": "Nama = Nongpal\n\njawab: \n    -0.3 log2(0.3) = -0.3 (-1.737) = 0.5211\n    -0.2 log2(0.2) = -0.2(-2.322) = 0.4644\n    -0.1 log2(0.1) = -0.1(-3.322) = 0.3322\n    -0.1 log2(0.1) = -0.1(-3.322) = 0.3322\n    -0.1 log2(0.1) = -0.1(-3.322) = 0.3322\n    -0.2 log2(0.2) = -0.2(-2.322) = 0.4644\n\n    total = 2.4465",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nama = Nongpal\n\njawab: \n    -0.3 log2(0.3) = -0.3 (-1.737) = 0.5211\n    -0.2 log2(0.2) = -0.2(-2.322) = 0.4644\n    -0.1 log2(0.1) = -0.1(-3.322) = 0.3322\n    -0.1 log2(0.1) = -0.1(-3.322) = 0.3322\n    -0.1 log2(0.1) = -0.1(-3.322) = 0.3322\n    -0.2 log2(0.2) = -0.2(-2.322) = 0.4644\n\n    total = 2.4465",
      "autoResize": true,
