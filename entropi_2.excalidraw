      "updated": 1748872056483,
      "link": null,
      "locked": false,
      "text": "H(x, y) = - [0.25 log2(0.25) + 0.25 log2(0.25) + 0.25log2(0.25) + 0.25log2(0.25)]\n\nlog2(0.25) = log2(1/4) = -2\n= - [4 x (0.25 x -2)] = -[4x(-0.5)] = -(-2) = 2",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H(x, y) = - [0.25 log2(0.25) + 0.25 log2(0.25) + 0.25log2(0.25) + 0.25log2(0.25)]\n\nlog2(0.25) = log2(1/4) = -2\n= - [4 x (0.25 x -2)] = -[4x(-0.5)] = -(-2) = 2",
      "autoResize": true,
      "lineHeight": 1.25
    },
