      "updated": 1748871732071,
      "link": null,
      "locked": false,
      "text": "logb(xy) = logb x + logb y\nlogb(x/y) = logb x - logb y\nlogb(x^n) = n . logb x\nlogb a = logc a/ logc b",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "logb(xy) = logb x + logb y\nlogb(x/y) = logb x - logb y\nlogb(x^n) = n . logb x\nlogb a = logc a/ logc b",
      "autoResize": true,
      "lineHeight": 1.25
    },
