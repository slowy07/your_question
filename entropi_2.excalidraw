      "link": null,
      "locked": false,
      "text": "H(x, y) = - [0.2 log2(0.2) + 0.3 log2(0.3) + 0.4log2(0.4) + 0.1 log2(0.1)]\n-0.2 log2(0.2) = 0.464\n-0.3 log2(0.3) = 0.521\n-0.4 log2(0.4) = 0.529\n-0.1 log2(0.1) = 0.332\n1.846",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "H(x, y) = - [0.2 log2(0.2) + 0.3 log2(0.3) + 0.4log2(0.4) + 0.1 log2(0.1)]\n-0.2 log2(0.2) = 0.464\n-0.3 log2(0.3) = 0.521\n-0.4 log2(0.4) = 0.529\n-0.1 log2(0.1) = 0.332\n1.846",
      "autoResize": true,
      "lineHeight": 1.25
    },
